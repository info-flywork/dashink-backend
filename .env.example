# --- Sunucu ---
NODE_ENV=production
# Her API'ye benzersiz port; sunucuda `sudo ss -tlnp` ile çakışmayı kontrol edin.
PORT=4130
HOST=127.0.0.1
LOG_LEVEL=info
# Virgülle ayrılmış origin listesi veya * (mobil uygulama için * yeterli)
CORS_ORIGIN=*
# Express trust proxy (nginx arkasında: loopback)
TRUST_PROXY=loopback

# --- Veritabanı (MariaDB / MySQL) ---
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
# Aynı VPS'te çok API var: havuz küçük kalsın (5-10)
DB_POOL_LIMIT=5

# --- Kimlik (JWT HS256) ---
# En az 32 karakter. Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# jsonwebtoken süre biçimi (1h, 30m, 3600)
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL_DAYS=90

# --- Günlük meydan okuma ---
# Günlük seed = HMAC-SHA256(DAILY_SEED_SECRET, "YYYY-MM-DD") ilk 31 bit. En az 16 karakter.
# Canlıya çıktıktan sonra DEĞİŞTİRMEYİN (o günün seed'i değişir, gönderilen skorlar 400 alır).
DAILY_SEED_SECRET=

# --- RevenueCat ---
# Secret API key (sk_...), /purchases/sync için REST v1 subscribers çağrısında kullanılır
REVENUECAT_SECRET_KEY=
# RevenueCat panelinde webhook "Authorization header value" alanına yazılan değerin aynısı
REVENUECAT_WEBHOOK_AUTH=
# Değiştirmeye gerek yok (test için)
REVENUECAT_API_BASE=https://api.revenuecat.com/v1

# --- Bunny CDN (paylaşılan klipler) ---
# Storage zone adı, storage password, pull zone host. Flutter'a asla gömme.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_PASSWORD=
BUNNY_STORAGE_HOST=storage.bunnycdn.com
BUNNY_PULL_ZONE_HOST=
